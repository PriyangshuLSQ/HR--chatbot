<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.leadsquared.hr</groupId>
  <artifactId>knowledge-backend</artifactId>
  <version>0.1.0</version>
  <name>people-insights-knowledge-backend</name>
  <description>HR knowledge base: parsing, chunking, embedding, hybrid retrieval and grounded answers</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Qdrant and Ollama are both reached over plain HTTP with RestClient.

      Qdrant ships a gRPC Java client, but this service needs three things it
      makes awkward: points stored *without* a vector (a chunk uploaded while
      Ollama was down), raw cosine scores fed into our own fusion formula, and
      free-form payloads. The REST API expresses all three directly, and keeps
      grpc/protobuf off the classpath entirely.
    -->

    <!--
      Answer writing runs on the Claude API. This is the one dependency that is a
      real SDK rather than hand-rolled HTTP, and deliberately so: the streaming
      wire format is Server-Sent Events with a dozen event types, retries and
      timeouts have non-obvious defaults, and getting any of it subtly wrong shows
      up as a truncated HR answer rather than an exception.

      Embedding does NOT go through here — Anthropic has no embeddings endpoint,
      and the Qdrant collections are 768-dimensional nomic-embed-text vectors.
      Query embedding stays on Ollama so the existing index keeps working; see
      OllamaClient.
    -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.34.0</version>
    </dependency>

    <!--
      PDF text extraction. The .txt/.md/.csv/.docx parsers are hand-rolled because
      those formats are a ZIP plus some XML, or nothing at all; PDF is not that kind
      of format. Its text is a stream of positioned glyph-drawing operators with no
      notion of a word, a line or a reading order, so "extract the text" means
      reconstructing all three from coordinates. That is what PDFBox's
      PDFTextStripper does, and it is not worth reimplementing.

      Also the source of the embedded images OCR reads: PDImageXObject exposes them
      already decoded, so nothing here has to understand DCTDecode or CCITTFaxDecode.
    -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.6</version>
    </dependency>

    <!--
      Reading the HR extract. It arrives as .xlsx workbooks — six of them, with title
      banners above the real header rows and a 183-column daily attendance register — so
      this is not a CSV parse in disguise.

      Streaming (SXSSF-style event reading) would use less memory, but the largest sheet
      here is 32,689 rows and the import runs once per extract, so the simpler DOM API is
      the right trade: a readable importer that HR Tech can follow beats a fast one.
    -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.1</version>
    </dependency>

    <!--
      Tickets, feedback and chat threads live in MongoDB Atlas.

      They are records, not vectors: HR reads them by id, filters them by status
      and sorts them by date, which is a document store's job and not Qdrant's.
      Keeping them out of `data/knowledge.json` also means the corpus file stays
      a corpus file — safe to wipe and re-ingest without losing an escalation.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!--
      Microsoft Entra ID sign-in, as an OAuth2 confidential client.

      The authorization code exchange happens here rather than in the Next.js
      frontend on purpose: the browser then holds a session cookie and nothing
      else, and every endpoint below is protected by the same filter chain. Doing
      it in the frontend would leave this service reachable unauthenticated —
      which is exactly the hole `/api/threads` had, where a caller could name any
      owner and read that person's chat history.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
