# Copy to .env — `docker compose` reads that file automatically.
#
#   cp .env.example .env
#
# Every value here has a working default in docker-compose.yml except the API
# key, so the stack comes up with this file empty. What you lose is written
# answers: retrieval and citations still work, phrased as verbatim passages.
# .env is gitignored (.env*.local plus .env); keep it that way.

# ---------------------------------------------------------------------------
# Claude — answer writing and OCR of images inside uploads
# ---------------------------------------------------------------------------
# Blank is supported: answers fall back to extractive, and a scanned PDF indexes
# as nothing rather than failing the upload.
ANTHROPIC_API_KEY=

# claude-haiku-4-5 is the default and the cheap/fast choice. Switch to
# claude-opus-5 if grounding cases start failing, or if scans read badly.
# CLAUDE_MODEL=claude-haiku-4-5
# KNOWLEDGE_CLAUDE_EFFORT=low

# ---------------------------------------------------------------------------
# Mongo — tickets, answer ratings, chat threads
# ---------------------------------------------------------------------------
# Defaults to the mongo container. Point at Atlas to keep using existing data:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB=hr_cockpit

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# Must match a Web redirect URI in the Entra app registration, as
# <APP_BASE_URL>/api/auth/callback/azure-ad.
# APP_BASE_URL=http://localhost:3000

# AUTH_REQUIRED=true makes the service refuse to start when sign-in is unusable,
# instead of serving every endpoint — compensation, leave, performance — with no
# authentication at all. It defaults to false so a fresh checkout boots. Set it
# true in anything holding the real employee extract.
# AUTH_REQUIRED=false

# Who sees the admin console, comma-separated. An Entra app role named HR.Admin
# wins over this list.
# ADMIN_EMAILS=

# Entra credentials — BOTH settings, or neither.
#
# Out of the box this stack runs with sign-in OFF: every endpoint is open and the
# frontend's demo login is used. That is fine for a local demo and unacceptable
# anywhere with the real employee extract loaded.
#
# Why it is two settings and not one: application.yml declares the `azure-ad`
# registration unconditionally and Spring validates it at startup, so with no
# credentials the service does not run open — it fails to boot with "Client id of
# registration 'azure-ad' must not be empty". docker-compose.yml therefore
# excludes the OAuth2 client autoconfiguration by default. Supplying credentials
# without clearing that exclusion configures a sign-in that is then switched off.
#
# To turn Entra on, uncomment both lines below:
#
#   1. Stop excluding the autoconfiguration (empty value, not deleted):
# SPRING_AUTOCONFIGURE_EXCLUDE=
#
#   2. Supply the credentials. SPRING_APPLICATION_JSON rather than discrete
#      SPRING_* variables because the registration id `azure-ad` contains a
#      hyphen, and Spring strips hyphens when binding from the environment — the
#      registration would come out as `azuread` and stop matching the callback
#      path. JSON keys survive intact. Single line, no spaces around `=`:
# SPRING_APPLICATION_JSON={"spring":{"security":{"oauth2":{"client":{"registration":{"azure-ad":{"client-id":"...","client-secret":"..."}},"provider":{"azure-ad":{"issuer-uri":"https://login.microsoftonline.com/<tenant>/v2.0"}}}}}}}
#
# Simpler alternative to step 2 if backend/application-local.yml already holds
# working credentials: uncomment its volume in docker-compose.yml and skip the
# JSON. Step 1 is still required either way, and it keeps the secret in a
# gitignored YAML file rather than in .env.

# ---------------------------------------------------------------------------
# The HR extract (.xlsx workbooks from HR Ops)
# ---------------------------------------------------------------------------
# A path INSIDE the container. ./data is mounted read-only at /data, so put the
# workbooks in ./data/hr-extract on the host and set:
# HR_EXTRACT_DIR=/data/hr-extract
