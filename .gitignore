# Environment variables
.env*.local
# Docker Compose reads .env automatically, and it holds ANTHROPIC_API_KEY and
# possibly the Atlas URI. .env.example is the committed template.
.env

# Backend build output and local secrets (the Atlas connection string)
backend/target/
backend/application-local.yml

# Per-developer Claude Code settings. Holds absolute paths from this machine and
# one person's tool allowlist — nothing secret, but nothing another clone wants.
.claude/settings.local.json

# Common ignores
node_modules
.next/
.DS_Store
# NLU test build output
.nlu-build/

# Uploaded HR documents and their embeddings — real employee-facing policy
# content, and large. Back this up separately; do not commit it.
data/
